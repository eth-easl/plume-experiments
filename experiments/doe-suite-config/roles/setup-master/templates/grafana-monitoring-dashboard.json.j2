{
  "id": null,
  "uid": "cluster-monitoring",
  "title": "Cluster Monitoring",
  "tags": [
    "doe-suite",
    "monitoring",
    "trino"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "{{ prometheus_interval }}",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 10,
              "lineWidth": 2,
              "showPoints": "never"
            },
            "unit": "percent"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "id": 1,
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "multi"
          }
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            },
            "expr": "100 - (avg by (inventory_host) (rate(node_cpu_seconds_total{job=\"node\",mode=\"idle\"}[{{ prometheus_rate_interval }}])) * 100)",
            "legendFormat": "{% raw %}{{ inventory_host }}{% endraw %}",
            "refId": "A"
          }
        ],
        "title": "CPU Used",
        "type": "timeseries"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "fieldConfig": {
